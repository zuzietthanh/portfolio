{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "input_type": "richtext"
    },
    "cover_image": {
      "type": "string",
      "title": "Cover Image",
      "input_type": "imageurl"
    },
    "tech_stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tech Stack"
    },
    "project_role": {
      "type": "string",
      "title": "Role"
    },
    "github_url": {
      "type": "string",
      "title": "GitHub URL"
    },
    "live_url": {
      "type": "string",
      "title": "Live URL"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "Featured"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "title": "Published"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}