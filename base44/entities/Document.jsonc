{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "cv",
        "cover_letter",
        "other"
      ],
      "default": "cv",
      "title": "Type"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "title": "Published"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}