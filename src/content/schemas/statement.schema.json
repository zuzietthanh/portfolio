{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Statement of Purpose",
  "description": "One object. The three sections are required by the assignment — keep all three.",
  "type": "object",
  "required": ["title", "sections"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "eyebrow": { "type": "string", "description": "Small label above the title." },
    "intro": { "type": "string", "description": "One or two sentences under the title." },
    "last_updated": { "type": "string", "description": "e.g. \"August 2026\"." },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "heading", "body"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "heading": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "description": "Small line under the heading." },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Your writing. Basic HTML allowed: <p>, <strong>, <em>, <ul>, <li>."
          }
        }
      }
    }
  }
}
