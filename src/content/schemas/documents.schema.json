{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documents",
  "description": "Your professional documents. Each needs the file, a revision story, and peer feedback.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "file_url"],
    "additionalProperties": false,
    "properties": {
      "_comment": { "type": "string" },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Web address for this document. Lowercase, no spaces, unique."
      },
      "title": { "type": "string", "minLength": 1 },
      "type": {
        "type": "string",
        "enum": ["cv", "cover_letter", "other"],
        "description": "Must be exactly one of these three. Picks the icon and label."
      },
      "file_url": {
        "type": "string",
        "minLength": 1,
        "description": "e.g. \"/documents/my-cv.pdf\". Put the file in public/documents/."
      },
      "description": { "type": "string", "description": "One line, shown on the card." },
      "summary": { "type": "string", "description": "Longer intro at the top of the detail page." },
      "external_url": { "type": "string", "description": "Optional live link, e.g. your LinkedIn." },
      "revision_narrative": {
        "type": "string",
        "description": "How the document changed and why. Basic HTML allowed."
      },
      "process_evidence": {
        "type": "array",
        "description": "Your drafts, oldest first.",
        "items": {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "description": "e.g. \"Draft 1\"." },
            "date": { "type": "string", "description": "e.g. \"Week 2\"." },
            "note": { "type": "string", "description": "What this version was like." },
            "file_url": { "type": "string", "description": "Optional link to that version." }
          }
        }
      },
      "peer_feedback": {
        "type": "array",
        "description": "What reviewers said and what you did about it.",
        "items": {
          "type": "object",
          "required": ["comment"],
          "additionalProperties": false,
          "properties": {
            "reviewer": { "type": "string" },
            "date": { "type": "string" },
            "comment": { "type": "string", "minLength": 1 },
            "response": { "type": "string", "description": "What you changed as a result." }
          }
        }
      },
      "sort_order": { "type": "number" },
      "is_published": { "type": "boolean" }
    }
  }
}
